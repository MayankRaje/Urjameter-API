{
  "info": {
    "_postman_id": "eb8bb3ce-3b97-4ea9-8b5b-f83e6a28b29e",
    "name": "Urjameter API - Recruiter Review",
    "description": "Self-contained local collection: import and run in order, with no environment selection or manual request inputs. Defaults target http://127.0.0.1:8080. Request 01 automatically captures a meter ID and serial for later requests. The Spring Boot server must already be running with its portal credentials configured. No credentials, cookies, or signing secrets are included. Signed export has passed live checks; session expiry remains unverified; success checks fail on upstream errors.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Meters",
      "item": [
        {
          "name": "01 - List meters (capture a meter for later requests)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/meters?search=&page=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "meters"
              ],
              "query": [
                {
                  "key": "search",
                  "value": ""
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "Sets meterId, search, and serialNumber in the collection from the first returned meter. No total count is hard-coded."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"JSON response\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"json\"); });",
                  "pm.test(\"Pagination contract\", function () { const b = pm.response.json(); pm.expect(b.data).to.be.an(\"array\"); pm.expect(b.pagination.page).to.be.a(\"number\"); pm.expect(b.pagination.pageSize).to.be.above(0); pm.expect(b.pagination.totalItems).to.be.at.least(0); pm.expect(b.pagination.totalPages).to.be.at.least(0); });",
                  "pm.test(\"First page\", function () { pm.expect(pm.response.json().pagination.page).to.eql(1); });",
                  "if (pm.response.code === 200) { const rows = pm.response.json().data; if (Array.isArray(rows) && rows.length) { pm.collectionVariables.set(\"meterId\", rows[0].meterId); pm.collectionVariables.set(\"search\", rows[0].meterId); pm.collectionVariables.set(\"serialNumber\", rows[0].serialNumber); } }"
                ]
              }
            }
          ],
          "response": []
        },
